# Hackday Radio / mixo-backend configuration - copy to .env and adjust.

# HTTP server port.
PORT=8080

# Directory for uploaded songs.
SONG_DIR=./songs

# SQLite database file path.
DB_PATH=./radio.db

# Timeout for slow streaming clients (seconds).
STREAM_TIMEOUT=30

# Comma-separated directories to scan for MP3s.
CRAWL_DIRS=../songs

# Target queue duration in hours.
QUEUE_HOURS=24

# How often to refill the queue (minutes).
CRAWL_INTERVAL=60

# Path to the ffmpeg binary used for normalization and HLS encoding.
FFMPEG_BIN=ffmpeg

# ---------------------------------------------------------------------------
# Admin interface password (HTTP Basic Auth on /admin).
# Leave ADMIN_PASSWORD empty to keep the admin page open.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# HLS output for the radio stream.
# On Ubuntu the default is the shared web root that nginx serves directly,
# which is also where the video streaming server (a11-video-stream) writes its
# own .m3u8 files. The radio playlist is written to:
#   $HLS_DIR/$HLS_STREAM_ID/index.m3u8
# ---------------------------------------------------------------------------
HLS_DIR=/var/www/html/hls
HLS_STREAM_ID=radio
HLS_SEGMENT_TIME=2
HLS_PLAYLIST_SIZE=6
